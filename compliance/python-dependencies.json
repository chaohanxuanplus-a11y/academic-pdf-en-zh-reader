{
  "schema_version": 1,
  "recipe": "scripts/build_compatible_dependencies.py",
  "scope": "Minimal Windows CPython 3.12 x64 project dependencies; not a complete Pillow replacement.",
  "sdk_version": "10.0.26100.0",
  "platform_toolset": "v143",
  "bit_identical_reproducibility_verified": false,
  "pillow_configuration": {
    "zlib": "enable",
    "jpeg": "enable",
    "freetype": "enable",
    "tiff": "disable",
    "webp": "disable",
    "jpeg2000": "disable",
    "lcms": "disable",
    "raqm": "disable",
    "imagequant": "disable",
    "xcb": "disable",
    "avif": "disable",
    "platform-guessing": "disable",
    "parallel": "2"
  },
  "native_configuration": {
    "libjpeg-turbo": {
      "WITH_SIMD": "OFF",
      "WITH_TURBOJPEG": "OFF",
      "WITH_JPEG8": "ON",
      "ENABLE_SHARED": "OFF",
      "WITH_CRT_DLL": "ON"
    },
    "zlib-ng": {
      "BUILD_SHARED_LIBS": "OFF",
      "ZLIB_COMPAT": "ON",
      "ZLIB_ENABLE_TESTS": "OFF"
    },
    "freetype": {
      "BUILD_SHARED_LIBS": "OFF",
      "FT_DISABLE_ZLIB": "ON",
      "FT_DISABLE_BZIP2": "ON",
      "FT_DISABLE_PNG": "ON",
      "FT_DISABLE_HARFBUZZ": "ON",
      "FT_DISABLE_BROTLI": "ON"
    }
  },
  "compiler_flags": [
    "/guard:cf"
  ],
  "pillow_linker_flags": [
    "/MANIFEST:NO",
    "/DYNAMICBASE",
    "/HIGHENTROPYVA",
    "/NXCOMPAT",
    "/guard:cf"
  ],
  "policy_note": "Documented build choices and license metadata differ from upstream wheels. The only C implementation change is the complete, fixed FreeType upstream TT_Get_Var_Design fix 5a280ecde6f324de0d226261036e736e0cb49a71 applied to 2.14.3; both source file hashes are checked. No project exploitability has been established. No installed/signed DLL is patched. Static image/font libraries are rebuilt from fixed official sources. CPython ABI is cp312; the production venv must use the separately validated compatible base. FreeType uses its bundled zlib when the external zlib dependency is disabled. Ordinary TTF/CJK fonts, PNG/JPEG and image primitives are required; optional formats, complex Raqm shaping, color-font PNG and Brotli fonts are not supplied. SIMD is disabled only for libjpeg-turbo (performance tradeoff). No Build Tools, SDK, or build-tool wheels are redistributed. Local build/host checks do not attest the full production LPAC path.",
  "source_changes": [
    {
      "source": "freetype",
      "path": "src/truetype/ttgxvar.c",
      "patch_source": "freetype-security-fix",
      "before_sha256": "b5ca576f480437e59f84a31ba2b569c7aadd31871f608034f6ea576340b88e10",
      "after_sha256": "061c22a4a388fd6a135f0099e4c9e8f86286ff3a82b91fcbfe6ae4049f18af06",
      "reason": "Apply both hunks of the single official TT_Get_Var_Design: Zero extras fix for upstream issue 1436, associated with CVE-2026-50811; no other master changes are included."
    }
  ],
