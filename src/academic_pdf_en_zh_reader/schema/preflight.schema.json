{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:preflight:1.0.0",
  "title": "Fail-closed PDF preflight result",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "source_sha256", "passed", "checks", "pages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "preflight"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "passed": {"type": "boolean"},
    "error_codes": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hard_gate", "passed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hard_gate": {"type": "boolean"},
          "passed": {"type": "boolean"},
          "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
          "details": {"type": ["string", "null"], "maxLength": 512}
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "width_mpt", "height_mpt", "rotation_degrees", "extractable_character_count"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "width_mpt": {"type": "integer", "minimum": 1},
          "height_mpt": {"type": "integer", "minimum": 1},
          "media_box_mpt": {"$ref": "#/$defs/box_mpt"},
          "crop_box_mpt": {"$ref": "#/$defs/box_mpt"},
          "rotation_degrees": {"enum": [0, 90, 180, 270]},
          "extractable_character_count": {"type": "integer", "minimum": 0},
          "topology_confidence_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "description": "Optional later-stage topology estimate; zero means not assessed."
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javascript", "open_actions", "attachments", "forms", "launch_actions", "rich_media", "submit_actions"],
      "properties": {
        "javascript": {"type": "integer", "minimum": 0},
        "open_actions": {"type": "integer", "minimum": 0},
        "attachments": {"type": "integer", "minimum": 0},
        "forms": {"type": "integer", "minimum": 0},
        "launch_actions": {"type": "integer", "minimum": 0},
        "rich_media": {"type": "integer", "minimum": 0},
        "submit_actions": {"type": "integer", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_bytes": {"$ref": "#/$defs/observed_limit"},
        "page_count": {"$ref": "#/$defs/observed_limit"},
        "object_count": {"$ref": "#/$defs/observed_limit"},
        "recursion_depth": {"$ref": "#/$defs/observed_limit"},
        "decompressed_stream_bytes": {"$ref": "#/$defs/observed_limit"},
        "image_bytes": {"$ref": "#/$defs/observed_limit"}
      }
    }
  },
  "$defs": {
    "box_mpt": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "observed_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "maximum"],
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0}
      }
    }
  }
}
