{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:normalization:1.0.0",
  "title": "Deterministic A4 source normalization receipt",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "policy_version", "source_sha256",
    "preflight_sha256", "normalized_pdf_sha256", "normalized_pdf_bytes",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "normalization"},
    "policy_version": {"const": "1.0.0"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "normalized_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "normalized_pdf_bytes": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "box_mpt": {
      "type": "array",
      "prefixItems": [
        {"type": "integer"}, {"type": "integer"},
        {"type": "integer"}, {"type": "integer"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "dimension_mpt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "padding_mpt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 841890
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number", "source_media_box_mpt", "source_crop_box_mpt",
        "source_rotation_degrees", "displayed_width_mpt",
        "displayed_height_mpt", "scale_ppm", "scaled_width_mpt",
        "scaled_height_mpt", "padding_left_mpt", "padding_bottom_mpt",
        "padding_right_mpt", "padding_top_mpt",
        "normalized_content_box_mpt"
      ],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "source_media_box_mpt": {"$ref": "#/$defs/box_mpt"},
        "source_crop_box_mpt": {"$ref": "#/$defs/box_mpt"},
        "source_rotation_degrees": {"enum": [0, 90, 180, 270]},
        "displayed_width_mpt": {"$ref": "#/$defs/dimension_mpt"},
        "displayed_height_mpt": {"$ref": "#/$defs/dimension_mpt"},
        "scale_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "scaled_width_mpt": {"$ref": "#/$defs/dimension_mpt"},
        "scaled_height_mpt": {"$ref": "#/$defs/dimension_mpt"},
        "padding_left_mpt": {"$ref": "#/$defs/padding_mpt"},
        "padding_bottom_mpt": {"$ref": "#/$defs/padding_mpt"},
        "padding_right_mpt": {"$ref": "#/$defs/padding_mpt"},
        "padding_top_mpt": {"$ref": "#/$defs/padding_mpt"},
        "normalized_content_box_mpt": {"$ref": "#/$defs/box_mpt"}
      }
    }
  }
}
