{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "$id": "urn:academic-pdf-en-zh-reader:schema:layout:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "line_mapping_version",
    "frame_graph_input_hash",
    "right_panel_bbox_mpt",
    "font_fingerprint",
    "flow_spacing",
    "solver_contract_version",
    "solver_input_hash",
    "frame_graph_hash",
    "solver_policy",
    "solver_trace",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "artifact_kind": {
      "const": "layout"
    },
    "line_mapping_version": {
      "const": 2
    },
    "frame_graph_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "right_panel_bbox_mpt": {
      "$ref": "#/$defs/box_mpt"
    },
    "font_fingerprint": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font_face"
      }
    },
    "flow_spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "horizontal_padding_mpt",
        "vertical_padding_mpt",
        "column_gap_mpt",
        "block_gap_mpt",
        "figure_note_gap_mpt"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "horizontal_padding_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "vertical_padding_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "column_gap_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "block_gap_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "figure_note_gap_mpt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "solver_contract_version": {
      "const": 3
    },
    "solver_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "frame_graph_hash": {
      "$ref": "#/$defs/sha256"
    },
    "solver_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "max_pages",
        "max_lines",
        "heading_with_next_lines"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "heading_with_next_lines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "solver_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuation_page_count",
        "chinese_page_count",
        "body_page_budget",
        "budget_exceeded"
      ],
      "properties": {
        "continuation_page_count": {
          "type": "integer",
          "minimum": 0
        },
        "chinese_page_count": {
          "type": "integer",
          "minimum": 1
        },
        "body_page_budget": {
          "type": "integer",
          "minimum": 1
        },
        "budget_exceeded": {
          "type": "boolean"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "box_mpt": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "font_face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reportlab_name",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "reportlab_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_id",
        "semantic_role",
        "font_role",
        "size_mpt",
        "line_height_mpt"
      ],
      "properties": {
        "style_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_role": {
          "enum": [
            "title",
            "abstract",
            "keywords",
            "heading",
            "body",
            "figure-caption",
            "table-caption",
            "footnote",
            "auxiliary"
          ]
        },
        "font_role": {
          "enum": [
            "body",
            "heading"
          ]
        },
        "size_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "line_height_mpt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "font_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_role",
        "font_name",
        "text"
      ],
      "properties": {
        "font_role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "target_start",
        "target_end",
        "text",
        "style_id",
        "width_mpt",
        "line_height_mpt",
        "ascent_mpt",
        "descent_mpt",
        "runs",
        "line_box_hash",
        "x_mpt",
        "baseline_y_mpt",
        "composite_start",
        "composite_end",
        "synthetic_annotation_ids"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "target_start": {
          "type": "integer",
          "minimum": 0
        },
        "target_end": {
          "type": "integer",
          "minimum": 0
        },
        "composite_start": {
          "type": "integer",
          "minimum": 0
        },
        "composite_end": {
          "type": "integer",
          "minimum": 1
        },
        "synthetic_annotation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "style_id": {
          "type": "string",
          "minLength": 1
        },
        "width_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "line_height_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "ascent_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "descent_mpt": {
          "type": "integer",
          "maximum": 0
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/font_run"
          }
        },
        "line_box_hash": {
          "$ref": "#/$defs/sha256"
        },
        "x_mpt": {
          "type": "integer"
        },
        "baseline_y_mpt": {
          "type": "integer"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "column_index",
        "column_count",
        "bbox_mpt",
        "text_left_mpt",
        "text_right_mpt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "column_index": {
          "enum": [
            0,
            1
          ]
        },
        "column_count": {
          "enum": [
            1,
            2
          ]
        },
        "bbox_mpt": {
          "$ref": "#/$defs/box_mpt"
        },
        "text_left_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "text_right_mpt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_id",
        "content_kind",
        "unit_id",
        "part_index",
        "frame_id",
        "line_start",
        "line_end",
        "line_sequence_hash",
        "style",
        "target_page_number",
        "source_page_numbers",
        "column_count",
        "column_index",
        "bbox_mpt",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "content_kind": {
          "enum": [
            "unit",
            "auxiliary"
          ]
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "part_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 0
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "line_sequence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "target_page_number": {
          "type": "integer",
          "minimum": 1
        },
        "source_page_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "column_count": {
          "enum": [
            1,
            2
          ]
        },
        "column_index": {
          "enum": [
            0,
            1
          ]
        },
        "bbox_mpt": {
          "$ref": "#/$defs/box_mpt"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "source_page_number",
        "page_kind",
        "continuation_index",
        "continuation_label",
        "frames",
        "blocks",
        "warning_region_mpt"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "source_page_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "page_kind": {
          "enum": [
            "native",
            "continuation"
          ]
        },
        "continuation_index": {
          "type": "integer",
          "minimum": 0
        },
        "continuation_label": {
          "type": "null"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "warning_region_mpt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    }
  }
}
