{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "$id": "urn:academic-pdf-en-zh-reader:schema:frame-graph:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "line_mapping_version",
    "frame_graph_input_hash",
    "right_panel_bbox_mpt",
    "font_fingerprint",
    "flow_spacing",
    "source_page_count",
    "body_page_budget",
    "warning_height_mpt",
    "brand_manifest_hash",
    "unit_flows",
    "auxiliary_flows",
    "flow_order",
    "annotation_binding",
    "source_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "artifact_kind": {
      "const": "frame-graph"
    },
    "line_mapping_version": {
      "const": 2
    },
    "frame_graph_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "right_panel_bbox_mpt": {
      "$ref": "#/$defs/box_mpt"
    },
    "font_fingerprint": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font_face"
      }
    },
    "flow_spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "horizontal_padding_mpt",
        "vertical_padding_mpt",
        "column_gap_mpt",
        "block_gap_mpt",
        "figure_note_gap_mpt"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "horizontal_padding_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "vertical_padding_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "column_gap_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "block_gap_mpt": {
          "type": "integer",
          "minimum": 0
        },
        "figure_note_gap_mpt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_page_count": {
      "type": "integer",
      "minimum": 1
    },
    "body_page_budget": {
      "type": "integer",
      "minimum": 1
    },
    "warning_height_mpt": {
      "type": "integer",
      "minimum": 1
    },
    "brand_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "unit_flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit_flow"
      }
    },
    "auxiliary_flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auxiliary_flow"
      }
    },
    "flow_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "annotation_binding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/annotation_binding"
        }
      ]
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parent_hash",
        "selection_hash"
      ],
      "properties": {
        "kind": {
          "enum": [
            "trial",
            "final"
          ]
        },
        "parent_hash": {
          "$ref": "#/$defs/sha256"
        },
        "selection_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "box_mpt": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "font_face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reportlab_name",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "reportlab_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_id",
        "semantic_role",
        "font_role",
        "size_mpt",
        "line_height_mpt"
      ],
      "properties": {
        "style_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_role": {
          "enum": [
            "title",
            "abstract",
            "keywords",
            "heading",
            "body",
            "figure-caption",
            "table-caption",
            "footnote",
            "auxiliary"
          ]
        },
        "font_role": {
          "enum": [
            "body",
            "heading"
          ]
        },
        "size_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "line_height_mpt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "font_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_role",
        "font_name",
        "text"
      ],
      "properties": {
        "font_role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "target_start",
        "target_end",
        "text",
        "style_id",
        "width_mpt",
        "line_height_mpt",
        "ascent_mpt",
        "descent_mpt",
        "runs",
        "line_box_hash",
        "composite_start",
        "composite_end",
        "synthetic_annotation_ids"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "target_start": {
          "type": "integer",
          "minimum": 0
        },
        "target_end": {
          "type": "integer",
          "minimum": 0
        },
        "composite_start": {
          "type": "integer",
          "minimum": 0
        },
        "composite_end": {
          "type": "integer",
          "minimum": 1
        },
        "synthetic_annotation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "style_id": {
          "type": "string",
          "minLength": 1
        },
        "width_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "line_height_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "ascent_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "descent_mpt": {
          "type": "integer",
          "maximum": 0
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/font_run"
          }
        },
        "line_box_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "styled_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "kind",
        "target_start",
        "target_end",
        "color_token",
        "underline"
      ],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "dark-red-highlight",
            "bright-red-ambiguity"
          ]
        },
        "target_start": {
          "type": "integer",
          "minimum": 0
        },
        "target_end": {
          "type": "integer",
          "minimum": 1
        },
        "color_token": {
          "enum": [
            "dark_red",
            "bright_red"
          ]
        },
        "underline": {
          "type": "boolean"
        }
      }
    },
    "composite_segment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "kind",
            "composite_start",
            "composite_end",
            "target_start",
            "target_end",
            "text"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "const": "target"
            },
            "composite_start": {
              "type": "integer",
              "minimum": 0
            },
            "composite_end": {
              "type": "integer",
              "minimum": 1
            },
            "target_start": {
              "type": "integer",
              "minimum": 0
            },
            "target_end": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "kind",
            "composite_start",
            "composite_end",
            "target_offset",
            "annotation_id",
            "text"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "const": "ambiguity-label"
            },
            "composite_start": {
              "type": "integer",
              "minimum": 0
            },
            "composite_end": {
              "type": "integer",
              "minimum": 1
            },
            "target_offset": {
              "type": "integer",
              "minimum": 0
            },
            "annotation_id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "kind",
            "composite_start",
            "composite_end",
            "target_offset",
            "annotation_id",
            "text"
          ],
          "properties": {
            "index": {
              "const": 0
            },
            "kind": {
              "const": "auxiliary-content"
            },
            "composite_start": {
              "const": 0
            },
            "composite_end": {
              "type": "integer",
              "minimum": 1
            },
            "target_offset": {
              "type": "integer",
              "minimum": 1
            },
            "annotation_id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "unit_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "role",
        "column_count",
        "source_page_numbers",
        "style",
        "lines",
        "line_count",
        "composite_segments",
        "composite_length",
        "styled_spans",
        "line_sequence_hash",
        "base_target_length"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "column_count": {
          "enum": [
            1,
            2
          ]
        },
        "source_page_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        },
        "composite_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/composite_segment"
          },
          "minItems": 1
        },
        "composite_length": {
          "type": "integer",
          "minimum": 1
        },
        "styled_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/styled_span"
          }
        },
        "line_sequence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "base_target_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "auxiliary_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "role",
        "column_count",
        "source_page_numbers",
        "style",
        "lines",
        "line_count",
        "composite_segments",
        "composite_length",
        "styled_spans",
        "line_sequence_hash",
        "id",
        "annotation_id",
        "annotation_kind",
        "parent_target_length",
        "attachment"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "column_count": {
          "enum": [
            1,
            2
          ]
        },
        "source_page_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        },
        "composite_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/composite_segment"
          },
          "minItems": 1
        },
        "composite_length": {
          "type": "integer",
          "minimum": 1
        },
        "styled_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/styled_span"
          }
        },
        "line_sequence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "annotation_kind": {
          "type": "string",
          "minLength": 1
        },
        "parent_target_length": {
          "type": "integer",
          "minimum": 1
        },
        "attachment": {
          "const": "below-translation"
        }
      }
    }
  }
}
