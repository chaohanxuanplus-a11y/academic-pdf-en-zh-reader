{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:job-state:1.0.0",
  "title": "Forward-only job state ledger",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "job_id", "source_sha256", "translation_revision", "stage", "reused_from_job_id", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "job-state"},
    "job_id": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "translation_revision": {"type": "integer", "minimum": 1},
    "stage": {"$ref": "#/$defs/stage"},
    "reused_from_job_id": {"type": ["string", "null"], "minLength": 1},
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "previous_state_hash", "artifact_hashes", "reused"],
        "properties": {
          "stage": {"$ref": "#/$defs/stage"},
          "previous_state_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "artifact_hashes": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
            "additionalProperties": {"$ref": "#/$defs/sha256"}
          },
          "reused": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"stage": {"const": "preflighted"}}},
            "then": {
              "properties": {
                "artifact_hashes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["preflight", "normalization", "normalized-pdf"],
                  "properties": {
                    "preflight": {"$ref": "#/$defs/sha256"},
                    "normalization": {"$ref": "#/$defs/sha256"},
                    "normalized-pdf": {"$ref": "#/$defs/sha256"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"stage": {"const": "laid_out"}}},
            "then": {
              "properties": {
                "artifact_hashes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["frame-graph", "layout", "finalization-receipt"],
                  "properties": {
                    "frame-graph": {"$ref": "#/$defs/sha256"},
                    "layout": {"$ref": "#/$defs/sha256"},
                    "finalization-receipt": {"$ref": "#/$defs/sha256"}
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"enum": ["initialized", "preflighted", "extracted", "translated", "independently_reviewed", "annotated", "laid_out", "rendered", "validated", "finalized"]}
  }
}
