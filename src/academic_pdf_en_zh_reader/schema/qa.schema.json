{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:qa:1.0.0",
  "title": "Hard-gate QA results",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "qa_policy_version",
    "render_manifest_hash", "finalization_receipt_hash",
    "source_pdf_sha256", "normalized_pdf_sha256", "output_pdf_sha256",
    "qa_config_hash",
    "checked_page_count", "rasterized_page_count", "passed", "checks"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "qa"},
    "qa_policy_version": {"const": 1},
    "render_manifest_hash": {"$ref": "#/$defs/sha256"},
    "finalization_receipt_hash": {"$ref": "#/$defs/sha256"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "normalized_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "output_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "qa_config_hash": {"$ref": "#/$defs/sha256"},
    "checked_page_count": {"type": "integer", "minimum": 0},
    "rasterized_page_count": {"type": "integer", "minimum": 0},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "hard_gate", "passed", "details"],
        "properties": {
          "id": {
            "enum": [
              "parent.chain",
              "semantic.translation-coverage",
              "semantic.independent-review",
              "content.annotation-policy",
              "geometry.a3-pages",
              "geometry.source-left-one-to-one",
              "geometry.mirrored-frames",
              "geometry.bounds-and-overlap",
              "geometry.leader-policy",
              "geometry.continuation-fixed-size",
              "font.embedded-tounicode",
              "font.draw-run-binding",
              "font.glyph-coverage",
              "security.active-content-absent",
              "security.no-raster-substitution",
              "render.pdfium-all-pages-144dpi",
              "render.left-visual-equivalence",
              "render.full-page-sanity"
            ]
          },
          "category": {"enum": ["semantic", "geometry", "font", "render", "content", "security"]},
          "hard_gate": {"type": "boolean"},
          "passed": {"type": "boolean"},
          "details": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z0-9_]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
