{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:annotations:1.0.0",
  "title": "Reading and learning annotations",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "units_hash",
    "translation_hash",
    "review_hash",
    "annotations_input_hash",
    "mandatory_items_hash",
    "candidate_set_hash",
    "orange_selection_hash",
    "selection_hash",
    "style_version",
    "colors",
    "auxiliary_size_mpt",
    "highlight_ratio_basis_points",
    "teaching_ratio_basis_points",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "annotations"
    },
    "units_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "translation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotations_input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mandatory_items_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "orange_selection_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "style_version": {
      "const": 1
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "dark_red",
        "dark_orange",
        "bright_red"
      ],
      "properties": {
        "body": {
          "const": "#111111"
        },
        "dark_red": {
          "const": "#7F1D1D"
        },
        "dark_orange": {
          "const": "#A84F08"
        },
        "bright_red": {
          "const": "#D00000"
        }
      }
    },
    "auxiliary_size_mpt": {
      "type": "integer",
      "minimum": 7000
    },
    "highlight_ratio_basis_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "teaching_ratio_basis_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit_id",
          "kind",
          "target_start",
          "target_end",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dark-red-highlight",
              "dark-orange-teaching",
              "figure-table-reading",
              "bright-red-ambiguity"
            ]
          },
          "target_start": {
            "type": "integer",
            "minimum": 0
          },
          "target_end": {
            "type": "integer",
            "minimum": 0
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_key": {
            "type": "string",
            "minLength": 1
          },
          "attachment": {
            "const": "below-translation"
          },
          "auxiliary_size_mpt": {
            "type": "integer",
            "minimum": 7000
          },
          "uses_continuation": {
            "type": "boolean"
          },
          "source_start": {
            "type": "integer",
            "minimum": 0
          },
          "source_end": {
            "type": "integer",
            "minimum": 1
          },
          "english_original": {
            "type": "string",
            "minLength": 1
          },
          "chinese_meaning": {
            "type": "string",
            "minLength": 1
          },
          "deferred_occurrences": {
            "type": "integer",
            "minimum": 0
          },
          "figure_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_kind",
                    "unit_id",
                    "source_start",
                    "source_end",
                    "quote"
                  ],
                  "properties": {
                    "evidence_kind": {
                      "const": "semantic-unit"
                    },
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "source_end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_kind",
                    "source_artifact_hash",
                    "object_id",
                    "locator",
                    "evidence_text",
                    "evidence_sha256"
                  ],
                  "properties": {
                    "evidence_kind": {
                      "const": "frozen-object"
                    },
                    "source_artifact_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "object_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              ]
            }
          },
          "essential": {
            "type": "boolean"
          },
          "compacted": {
            "type": "boolean"
          },
          "ambiguity_key_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "underline": {
            "type": "boolean"
          },
          "label_after_span": {
            "type": "boolean"
          },
          "label_size_mpt": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "dark-red-highlight"
                }
              }
            },
            "then": {
              "required": [
                "candidate_id",
                "content"
              ],
              "properties": {
                "content": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "dark-orange-teaching"
                }
              }
            },
            "then": {
              "required": [
                "candidate_key",
                "content",
                "auxiliary_size_mpt",
                "uses_continuation",
                "source_start",
                "source_end",
                "english_original",
                "chinese_meaning",
                "deferred_occurrences",
                "attachment"
              ],
              "properties": {
                "uses_continuation": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "figure-table-reading"
                }
              }
            },
            "then": {
              "required": [
                "candidate_key",
                "content",
                "auxiliary_size_mpt",
                "uses_continuation",
                "figure_id",
                "evidence",
                "essential",
                "compacted",
                "attachment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bright-red-ambiguity"
                }
              }
            },
            "then": {
              "required": [
                "ambiguity_key_id",
                "content",
                "underline",
                "label_after_span",
                "label_size_mpt"
              ],
              "properties": {
                "underline": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  }
}
