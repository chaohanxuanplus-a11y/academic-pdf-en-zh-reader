{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-pdf-en-zh-reader:schema:render-manifest:1.0.0",
  "title": "Deterministic render manifest v2",
  "x-spdx-copyright": "2026 academic-pdf-en-zh-reader contributors",
  "x-spdx-license-identifier": "Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "render_manifest_version",
    "finalization_receipt_hash",
    "source_sha256",
    "normalized_pdf_sha256",
    "source_artifact_hash",
    "annotations_hash",
    "annotation_selection_hash",
    "frame_graph_hash",
    "layout_hash",
    "render_style",
    "render_style_hash",
    "font_manifest_hash",
    "font_fingerprint",
    "font_files",
    "font_usages",
    "overlay_plan_hash",
    "overlay_plan_limits",
    "overlay_plan_limits_hash",
    "overlay_pdf_sha256",
    "render_input_hash",
    "dependencies",
    "runtime_fingerprint",
    "metadata_policy",
    "pages",
    "block_mappings",
    "output_pdf_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "render-manifest"
    },
    "render_manifest_version": {
      "const": 2
    },
    "finalization_receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normalized_pdf_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_artifact_hash": {
      "$ref": "#/$defs/sha256"
    },
    "annotations_hash": {
      "$ref": "#/$defs/sha256"
    },
    "annotation_selection_hash": {
      "$ref": "#/$defs/sha256"
    },
    "frame_graph_hash": {
      "$ref": "#/$defs/sha256"
    },
    "layout_hash": {
      "$ref": "#/$defs/sha256"
    },
    "render_style": {
      "$ref": "#/$defs/render_style"
    },
    "render_style_hash": {
      "$ref": "#/$defs/sha256"
    },
    "font_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "font_fingerprint": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/font_fingerprint"
      }
    },
    "font_files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/font_file"
      }
    },
    "font_usages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/font_usage"
      }
    },
    "overlay_plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "overlay_plan_limits": {
      "$ref": "#/$defs/overlay_limits"
    },
    "overlay_plan_limits_hash": {
      "$ref": "#/$defs/sha256"
    },
    "overlay_pdf_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "render_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pypdf",
        "reportlab"
      ],
      "properties": {
        "pypdf": {
          "type": "string",
          "minLength": 1
        },
        "reportlab": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_implementation",
        "python_version",
        "platform"
      ],
      "properties": {
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata_policy": {
      "$ref": "#/$defs/metadata_policy"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page_mapping"
      }
    },
    "block_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block_mapping"
      }
    },
    "output_pdf_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "box_mpt": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "matrix_mpt": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "font_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reportlab_name",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "reportlab_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "font_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "reportlab_name",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reportlab_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "font_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_role",
        "font_name",
        "size_mpt",
        "draw_run_count",
        "character_count"
      ],
      "properties": {
        "font_role": {
          "enum": [
            "body",
            "heading",
            "symbols"
          ]
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "size_mpt": {
          "type": "integer",
          "minimum": 1
        },
        "draw_run_count": {
          "type": "integer",
          "minimum": 1
        },
        "character_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "render_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "colors",
        "underline"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body",
            "dark_red",
            "dark_orange",
            "bright_red",
            "muted_gray"
          ],
          "properties": {
            "body": {
              "const": "#111111"
            },
            "dark_red": {
              "const": "#7F1D1D"
            },
            "dark_orange": {
              "const": "#A84F08"
            },
            "bright_red": {
              "const": "#D00000"
            },
            "muted_gray": {
              "const": "#666666"
            }
          }
        },
        "underline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "offset_mpt",
            "thickness_mpt"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "offset_mpt": {
              "type": "integer"
            },
            "thickness_mpt": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "overlay_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "max_pages",
        "max_blocks_per_page",
        "max_lines",
        "max_characters",
        "max_draw_runs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_blocks_per_page": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_characters": {
          "type": "integer",
          "minimum": 1
        },
        "max_draw_runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metadata_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_document_metadata",
        "source_annotations",
        "source_active_content",
        "creation_date",
        "modification_date"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "source_document_metadata": {
          "const": "discarded"
        },
        "source_annotations": {
          "const": "stripped"
        },
        "source_active_content": {
          "const": "rejected"
        },
        "creation_date": {
          "const": "D:20000101000000+00'00'"
        },
        "modification_date": {
          "const": "D:20000101000000+00'00'"
        }
      }
    },
    "page_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_page_number",
        "source_page_number",
        "page_kind",
        "continuation_index",
        "source_crop_box_mpt",
        "source_normalized_visible_box_mpt",
        "source_rotation_degrees",
        "source_transform_mpt",
        "overlay_page_plan_hash",
        "overlay_image_fingerprints",
        "continuation_label_present"
      ],
      "properties": {
        "output_page_number": {
          "type": "integer",
          "minimum": 1
        },
        "source_page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_kind": {
          "enum": [
            "native",
            "continuation"
          ]
        },
        "continuation_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_crop_box_mpt": {
          "anyOf": [
            {
              "$ref": "#/$defs/box_mpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_normalized_visible_box_mpt": {
          "anyOf": [
            {
              "$ref": "#/$defs/box_mpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270,
            null
          ]
        },
        "source_transform_mpt": {
          "anyOf": [
            {
              "$ref": "#/$defs/matrix_mpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay_page_plan_hash": {
          "$ref": "#/$defs/sha256"
        },
        "overlay_image_fingerprints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "continuation_label_present": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "page_kind": {
            "const": "continuation"
          }
        }
      },
      "then": {
        "properties": {
          "source_page_number": {
            "type": "null"
          },
          "source_crop_box_mpt": {
            "type": "null"
          },
          "source_normalized_visible_box_mpt": {
            "type": "null"
          },
          "source_rotation_degrees": {
            "type": "null"
          },
          "source_transform_mpt": {
            "type": "null"
          },
          "continuation_index": {
            "type": "integer",
            "minimum": 1
          },
          "continuation_label_present": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "source_page_number": {
            "type": "integer"
          },
          "source_crop_box_mpt": {
            "$ref": "#/$defs/box_mpt"
          },
          "source_normalized_visible_box_mpt": {
            "$ref": "#/$defs/box_mpt"
          },
          "source_rotation_degrees": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "source_transform_mpt": {
            "$ref": "#/$defs/matrix_mpt"
          }
        }
      }
    },
    "block_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "content_id",
        "content_kind",
        "unit_id",
        "part_index",
        "output_page_number",
        "frame_id",
        "bbox_mpt"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "content_kind": {
          "enum": [
            "unit",
            "figure-note",
            "auxiliary"
          ]
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "part_index": {
          "type": "integer",
          "minimum": 0
        },
        "output_page_number": {
          "type": "integer",
          "minimum": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "bbox_mpt": {
          "$ref": "#/$defs/box_mpt"
        }
      }
    }
  }
}
